          },
          {
            "type": "string",
            "title": "custom_too_long",
            "enum": [
              "custom_too_long"
            ],
            "description": "custom is too long"
          },
          {
            "type": "string",
            "title": "autofill_invalid",
            "enum": [
              "autofill_invalid"
            ],
