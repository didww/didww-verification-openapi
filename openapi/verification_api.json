{
  "openapi": "3.0.3",
  "info": {
    "title": "DIDWW Verification API",
    "version": "v1",
    "description": "REST API to create phone-number verifications and report the code the user\nreceived. Requests are authenticated with the OTP application key: HTTP Basic\n(key and secret), a signed request, or the bare key (public mode), as far as\nthe application's minimum authentication mode allows.\n\nRate limits, each counted per second. Above a limit the API answers 429 with\none of the error codes below and a `Retry-After: 1` header.\n- Public mode, per client IP address, across all accounts: 10 requests from\n  one IPv4 address, 2 from one IPv6 /64 (`rate_limit_per_ip`).\n- Failed authentication, per client IP address: after 5 failures from one IPv4\n  address or IPv6 /48, further requests are refused (`rate_limit_failed_auth`).\n- Per account, from any IP address: 10 requests (`rate_limit_per_account`),\n  of which 5 may be public mode (`rate_limit_public_per_account`).\n\nSupport can adjust the per-account limits. Daily and monthly volume limits per\napplication are described on POST /api/v1/verifications.\n",
    "license": {
      "name": "MIT",
      "url": "https://github.com/didww/didww-verification-openapi/blob/main/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://verification.didww.com",
      "description": "Production"
    },
    {
      "url": "https://verification-sandbox.didww.com",
      "description": "Sandbox: no real SMS or calls are sent. Test numbers and outcomes: https://doc.didww.com/otp-verification/testing.html"
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "OTP application key (username) and secret (password)."
      }
    },
    "schemas": {
      "CreateVerificationRequest": {
        "description": "Payload to create a verification. Use the branch matching the delivery method: each accepts only its own options block.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/CreateSMSVerificationRequest"
          },
          {
            "$ref": "#/components/schemas/CreateCalloutVerificationRequest"
          }
        ]
      },
      "CreateSMSVerificationRequest": {
        "title": "Create an SMS verification",
        "description": "Deliver the code in a text message.",
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "destination",
              "delivery_method"
            ],
            "additionalProperties": false,
            "properties": {
              "destination": {
                "type": "string",
                "description": "Phone number to verify, in E.164 (leading + optional).",
                "example": "+4915112345678"
              },
              "delivery_method": {
                "type": "string",
                "enum": [
                  "sms"
                ],
                "description": "How the code is delivered. Always \"sms\" in this payload.",
                "example": "sms"
              },
              "custom": {
                "type": "string",
                "maxLength": 4096,
                "description": "Free text passed unchanged to your callback server in the verification_request event; never returned by this API. Reaches nobody when no callback is made: a signed request, or an application without a callback URL. Set from a mobile app, it is client-controlled: validate it against your own records. Do not put secrets in it.",
                "example": "session=7f3c9a"
              },
              "sms": {
                "type": "object",
                "description": "Options for the sms delivery method.",
                "properties": {
                  "languages": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "de-DE",
                      "en-US"
                    ],
                    "description": "Preferred content languages (BCP 47 tags), most preferred first. Tags are matched exactly, so a region subtag is required: \"pl\" does not match the pl-PL template. Unmatched tags fall back to en-US. Supported: bg-BG, bs-BA, cs-CZ, da-DK, de-DE, el-GR, en-GB, en-US, es-419, es-ES, et-EE, fi-FI, fr-FR, he-IL, hr-HR, hu-HU, is-IS, it-IT, ja-JP, ka-GE, lt-LT, lv-LV, mk-MK, ms-MY, mt-MT, nb-NO, nl-NL, pl-PL, pt-BR, pt-PT, ro-RO, ru-RU, sk-SK, sl-SI, sq-AL, sr-RS, sv-SE, th-TH, uk-UA, zh-CN, zh-HK."
                  },
                  "autofill": {
                    "type": "object",
                    "nullable": true,
                    "additionalProperties": false,
                    "required": [
                      "type"
                    ],
                    "description": "Handset autofill marker added to the message. Omitted or null uses the application default (domain when the application has an sms_domain, otherwise none). A malformed object, or one sent together with the deprecated sms.app_hash → 422 autofill_invalid.",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "app_hash",
                          "domain",
                          "none"
                        ],
                        "example": "app_hash",
                        "description": "app_hash: Android SMS Retriever; the message is prefixed with \"<#> \" and the hash is appended as its final token. domain: iOS; \"@<sms_domain> #<code>\" is appended as the last line, or 422 sms_domain_not_configured. none: no marker."
                      },
                      "value": {
                        "type": "string",
                        "example": "A1b2C3d4E5f",
                        "description": "Required for app_hash, forbidden otherwise. Exactly 11 characters of [A-Za-z0-9+/]; a wrong format → 422 app_hash_invalid."
                      }
                    }
                  },
                  "app_hash": {
                    "type": "string",
                    "nullable": true,
                    "deprecated": true,
                    "example": "A1b2C3d4E5f",
                    "description": "Deprecated, use autofill {type: app_hash, value}. Read only when autofill is omitted; a wrong format → 422 app_hash_invalid, sending both → 422 autofill_invalid."
                  },
                  "template_group": {
                    "type": "string",
                    "nullable": true,
                    "example": "acme-login",
                    "description": "Name of a custom SMS template group (see the user panel). Overrides the application default when both are set. Unknown name → 422 template_group_not_found."
                  }
                }
              }
            }
          }
        }
      },
      "CreateCalloutVerificationRequest": {
        "title": "Create a callout verification",
        "description": "Place a phone call that announces the code.",
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "destination",
              "delivery_method"
            ],
            "additionalProperties": false,
            "properties": {
              "destination": {
                "type": "string",
                "description": "Phone number to verify, in E.164 (leading + optional).",
                "example": "+4915112345678"
              },
              "delivery_method": {
                "type": "string",
                "enum": [
                  "callout"
                ],
                "description": "How the code is delivered. Always \"callout\" in this payload.",
                "example": "callout"
              },
              "custom": {
                "type": "string",
                "maxLength": 4096,
                "description": "Free text passed unchanged to your callback server in the verification_request event; never returned by this API. Reaches nobody when no callback is made: a signed request, or an application without a callback URL. Set from a mobile app, it is client-controlled: validate it against your own records. Do not put secrets in it.",
                "example": "session=7f3c9a"
              },
              "callout": {
                "type": "object",
                "description": "Options for the callout delivery method.",
                "properties": {
                  "languages": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "example": "pt-BR"
                    },
                    "description": "Preferred announcement languages (BCP 47 tags), most preferred first — the same tags and the same semantics as sms.languages, so one language list works for both channels. Tags are matched exactly, so a region subtag is required: \"pt\" does not match the pt-PT recording. Unmatched tags fall back to en-US; the tag actually used is returned as callout.language. Supported: af-ZA, ar-AE, ar-EG, ar-SA, bg-BG, bs-BA, cs-CZ, da-DK, de-DE, el-GR, en-GB, en-US, es-419, es-ES, et-EE, fi-FI, fr-FR, he-IL, hi-IN, hr-HR, hu-HU, id-ID, is-IS, it-IT, ja-JP, lt-LT, lv-LV, mk-MK, ms-MY, nb-NO, nl-NL, pl-PL, pt-BR, pt-PT, ro-RO, sk-SK, sl-SI, sr-RS, sv-SE, sw-KE, th-TH, tl-PH, tr-CY, tr-TR, uk-UA, ur-PK, vi-VN, zh-CN, zh-HK. Four of those are served by an approximate recording: en-GB — one English recording, US-accented; es-419 — one Spanish recording, informal register; ar-AE, ar-EG, ar-SA — Modern Standard Arabic, not a regional dialect; tr-CY — standard Turkish. Tags with an SMS template but no announcement audio (ka-GE, mt-MT, ru-RU, sq-AL) are accepted and fall back to en-US."
                  },
                  "template_group": {
                    "type": "string",
                    "nullable": true,
                    "example": "acme-login",
                    "description": "Name of a custom voice template group (see the user panel). Overrides the application default when both are set. Unknown name → 422 template_group_not_found."
                  }
                }
              }
            }
          }
        }
      },
      "ReportVerificationRequest": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "delivery_method"
            ],
            "properties": {
              "delivery_method": {
                "type": "string",
                "enum": [
                  "callout",
                  "sms"
                ],
                "description": "Must match the delivery method of the verification.",
                "example": "sms"
              },
              "code": {
                "type": "string",
                "description": "The OTP code the user received.",
                "example": "123456"
              }
            }
          }
        }
      },
      "VerificationErrorCode": {
        "title": "VerificationErrorCode",
        "description": "Stable, machine-readable code explaining a failed/expired/denied verification; null while pending or once verified.",
        "type": "string",
        "nullable": true,
        "oneOf": [
          {
            "type": "string",
            "title": "dispatch_failed",
            "enum": [
              "dispatch_failed"
            ],
            "description": "failed to deliver"
          },
          {
            "type": "string",
            "title": "expired",
            "enum": [
              "expired"
            ],
            "description": "expired"
          },
          {
            "type": "string",
            "title": "too_many_attempts",
            "enum": [
              "too_many_attempts"
            ],
            "description": "too many attempts"
          },
          {
            "type": "string",
            "title": "application_deleted",
            "enum": [
              "application_deleted"
            ],
            "description": "application deleted"
          },
          {
            "type": "string",
            "title": "superseded",
            "enum": [
              "superseded"
            ],
            "description": "superseded"
          },
          {
            "type": "string",
            "title": "denied_missing_callback_url",
            "enum": [
              "denied_missing_callback_url"
            ],
            "description": "application has no callback_url"
          },
          {
            "type": "string",
            "title": "denied_by_callback",
            "enum": [
              "denied_by_callback"
            ],
            "description": "your callback denied the request"
          },
          {
            "type": "string",
            "title": "denied_invalid_callback_response",
            "enum": [
              "denied_invalid_callback_response"
            ],
            "description": "callback response was invalid"
          },
          {
            "type": "string",
            "title": "destination_not_supported_for_channel",
            "enum": [
              "destination_not_supported_for_channel"
            ],
            "description": "destination not supported for provided delivery method"
          },
          {
            "type": "string",
            "title": "application_paused",
            "enum": [
              "application_paused"
            ],
            "description": "application is paused"
          },
          {
            "type": "string",
            "title": "destination_country_disabled",
            "enum": [
              "destination_country_disabled"
            ],
            "description": "destination country is disabled in account settings"
          }
        ],
        "example": "too_many_attempts"
      },
      "Verification": {
        "type": "object",
        "required": [
          "id",
          "destination",
          "delivery_method",
          "fee",
          "status",
          "error_code",
          "error_detail",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Verification identifier.",
            "example": "01a0435e-2b71-7762-b0c2-22fabc5ed19c"
          },
          "destination": {
            "type": "string",
            "example": "4915112345678"
          },
          "delivery_method": {
            "type": "string",
            "enum": [
              "callout",
              "sms"
            ],
            "example": "sms"
          },
          "fee": {
            "type": "string",
            "description": "Charged fee including VAT, as a decimal string.",
            "example": "0.06"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "verified",
              "failed",
              "expired",
              "denied"
            ],
            "description": "Public verification status.",
            "example": "pending"
          },
          "error_code": {
            "$ref": "#/components/schemas/VerificationErrorCode"
          },
          "error_detail": {
            "type": "string",
            "nullable": true,
            "description": "Fixed human-readable text for `error_code` (see the VerificationErrorCode catalog); null when `error_code` is null.",
            "example": "too many attempts"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the verification expires (ISO 8601). Always set — it is assigned at creation and kept on finished verifications.",
            "example": "2026-08-27T13:19:20Z"
          },
          "sms": {
            "type": "object",
            "description": "Present only for the sms delivery method.",
            "required": [
              "template",
              "language",
              "interception_timeout",
              "code_length",
              "template_group",
              "template_group_used",
              "template_fallback_reason"
            ],
            "properties": {
              "template": {
                "type": "string",
                "example": "Your code is {{CODE}}"
              },
              "language": {
                "type": "string",
                "example": "de-DE",
                "description": "The content-language tag the system chose: the first requested tag that matched a template, or en-US when none did. Compare it with what you asked for to detect a fallback."
              },
              "interception_timeout": {
                "type": "integer",
                "example": 300,
                "description": "Seconds a client should keep an on-device SMS listener armed. A fixed budget, not a countdown. Automatic capture stopping is not a verification deadline: manual entry works until expires_at."
              },
              "code_length": {
                "type": "integer",
                "minimum": 4,
                "maximum": 8,
                "example": 6,
                "description": "Number of digits in the code that was sent, so the client can size its input. Configured per application; this is the length of THIS verification's code, not the current setting."
              },
              "autofill": {
                "type": "object",
                "required": [
                  "type",
                  "value"
                ],
                "description": "Present only when an autofill marker was added to the SMS. Reflects what was persisted, not what was requested.",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "app_hash",
                      "domain"
                    ],
                    "example": "app_hash"
                  },
                  "value": {
                    "type": "string",
                    "example": "A1b2C3d4E5f",
                    "description": "The app hash or the sms_domain."
                  }
                }
              },
              "app_hash": {
                "type": "string",
                "deprecated": true,
                "example": "A1b2C3d4E5f",
                "description": "Deprecated, use autofill.value. Present only for type app_hash."
              },
              "template_group": {
                "type": "string",
                "nullable": true,
                "example": "acme-login",
                "description": "Name of the custom template group applied, or null when none was."
              },
              "template_group_used": {
                "type": "boolean",
                "example": false,
                "description": "Whether template_group actually produced the delivered text/audio."
              },
              "template_fallback_reason": {
                "type": "string",
                "nullable": true,
                "enum": [
                  null,
                  "language_missing",
                  "version_pending",
                  "version_rejected",
                  "audio_not_ready",
                  "group_missing"
                ],
                "example": null,
                "description": "Why template_group_used is false; null when it is true."
              }
            }
          },
          "callout": {
            "type": "object",
            "description": "Present only for the callout delivery method.",
            "required": [
              "language",
              "code_length",
              "template_group",
              "template_group_used",
              "template_fallback_reason"
            ],
            "properties": {
              "language": {
                "type": "string",
                "example": "pt-BR",
                "description": "The content-language tag the announcement is played in: the first requested tag that matched a recording, or en-US when none did. Compare it with what you asked for to detect a fallback."
              },
              "code_length": {
                "type": "integer",
                "minimum": 4,
                "maximum": 8,
                "example": 6,
                "description": "Number of digits in the code that is announced, so the client can size its input. Configured per application; this is the length of THIS verification's code, not the current setting."
              },
              "template_group": {
                "type": "string",
                "nullable": true,
                "example": "acme-login",
                "description": "Name of the custom template group applied, or null when none was."
              },
              "template_group_used": {
                "type": "boolean",
                "example": false,
                "description": "Whether template_group actually produced the delivered text/audio."
              },
              "template_fallback_reason": {
                "type": "string",
                "nullable": true,
                "enum": [
                  null,
                  "language_missing",
                  "version_pending",
                  "version_rejected",
                  "audio_not_ready",
                  "group_missing"
                ],
                "example": null,
                "description": "Why template_group_used is false; null when it is true."
              }
            }
          }
        }
      },
      "VerificationResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Verification"
          }
        }
      },
      "ErrorCode": {
        "title": "ErrorCode",
